# Copy to .env for local runs. Base URLs live here — run.ts and the
# frontend both read them. Never commit a real .env with keys.
#
#   cp .examples.env .env
#   bun run.ts

# ---- base URLs (the two numbers that matter) ----
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000

# ---- backend sources (empty = offline seed mode) ----
XKDR_API_KEY=
AIQ_TZ=Asia/Kolkata
AWS_REGION=us-west-2

# ---- optional overrides ----
# AIQ_SCHOOLS=examples/schools.json
# AIQ_USERS=examples/users.json
# AIQ_SEED_REGIONS=examples/regions_daily.json
# AIQ_DATA_DIR=backend/data
